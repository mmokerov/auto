{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "sh -c \"json-server --watch /db.json --host 0.0.0.0 --port 3000 & nginx -g 'daemon off;'\"",
    "healthcheckPath": "/api/waybills",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE"
  }
}
